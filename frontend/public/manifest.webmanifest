{
  "name": "Open Writer",
  "short_name": "Writer",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#faf9f6",
  "theme_color": "#7c5cbf",
  "description": "A private writing editor: spelling, grammar, and style checks on your device, with optional AI using your own key.",
  "icons": [
    {
      "src": "logo.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "logo-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "id": "./",
  "scope": "./"
}
