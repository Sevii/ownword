{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot.schema.json",
  "title": "Snapshot",
  "description": "An immutable view of one document revision. Offsets everywhere are zero-based UTF-16 code units, half-open, block-local.",
  "type": "object",
  "required": ["contractVersion", "documentId", "revision", "settingsRevision", "schemaVersion", "blocks"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "settingsRevision": { "type": "integer", "minimum": 0 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "type", "text", "marks", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["paragraph", "heading", "listItem", "blockquote", "codeBlock"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/markSpan" } },
        "fingerprint": { "type": "string" }
      }
    },
    "markSpan": {
      "type": "object",
      "required": ["from", "to", "type"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "type": { "enum": ["bold", "italic", "code", "link"] },
        "href": { "type": "string" }
      }
    }
  }
}
